#version 450

// Retain the adjacent-load and final-word checks from momoten's
// coalesced_buffer_load.comp without cross-descriptor read-after-write.
layout(local_size_x = 64) in;
layout(binding = 0) readonly buffer Input { float values[]; } input_data;
layout(binding = 1) writeonly buffer Output { float values[]; } output_data;

void main()
{
    uint i = gl_GlobalInvocationID.x;
    if (i < 63)
    {
        vec2 value = vec2(input_data.values[i * 2], input_data.values[i * 2 + 1]);
        output_data.values[i * 2] = value.x;
        output_data.values[i * 2 + 1] = value.y;
    }
    else if (i == 63)
    {
        output_data.values[126] = input_data.values[126];
    }
}
