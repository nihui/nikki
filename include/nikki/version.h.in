#ifndef NIKKI_VERSION_H
#define NIKKI_VERSION_H
#define NIKKI_VERSION_STRING "@NIKKI_VERSION@"
#define NIKKI_RELEASE_VERSION @NIKKI_RELEASE_VERSION@u
#define NIKKI_RELEASE_VERSION_STRING "@NIKKI_RELEASE_VERSION@"
// Vulkan-compatible date encoding: 20261024 -> 26.10.24.
#define NIKKI_DRIVER_VERSION_MAJOR @NIKKI_DRIVER_VERSION_MAJOR@
#define NIKKI_DRIVER_VERSION_MINOR @NIKKI_DRIVER_VERSION_MINOR@
#define NIKKI_DRIVER_VERSION_PATCH @NIKKI_DRIVER_VERSION_PATCH@
#endif
